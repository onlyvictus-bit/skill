:"a7f7639db6ac861dc8d896f89c66ee7ac644031e699c351f5b0ed09e63c6dc06","text":"    if sample['revoked']:\n","unit_id":"U000006","unit_sha256":"1422f628b6a8248f8978a10b289c3380aeac7e2d7b1f03e8118f36916669977d"},{"authority":"AUTHORITATIVE","path":"pipeline.py","range":[156,199],"source_id":"pipeline","source_sha256":"a7f7639db6ac861dc8d896f89c66ee7ac644031e699c351f5b0ed09e63c6dc06","text":"        raise ValueError('ACCESS_REVOKED')\n","unit_id":"U000007","unit_sha256":"9347efe24408e508604821a79baf60aeda8cc8dbd80a4a65530fab077321dc6d"},{"authority":"AUTHORITATIVE","path":"pipeline.py","range":[199,245],"source_id":"pipeline","source_sha256":"a7f7639db6ac861dc8d896f89c66ee7ac644031e699c351f5b0ed09e63c6dc06","text":"    if not fresh(sample['captured_at'], now):\n","unit_id":"U000008","unit_sha256":"bf91825a2f9dcb56ca27814a85d47b531ffd71da32705b35e404933c716f442c"},{"authority":"AUTHORITATIVE","path":"pipeline.py","range":[245,285],"source_id":"pipeline","source_sha256":"a7f7639db6ac861dc8d896f89c66ee7ac644031e699c351f5b0ed09e63c6dc06","text":"        raise ValueError('STALE_INPUT')\n","unit_id":"U000009","unit_sha256":"df6ec30455bef5f63b8f5e10cf90dcea6fecfe4c0886b9e3bfe6408d489e33c6"},{"authority":"AUTHORITATIVE","path":"pipeline.py","range":[285,311],"source_id":"pipeline","source_sha256":"a7f7639db6ac861dc8d896f89c66ee7ac644031e699c351f5b0ed09e63c6dc06","text":"    return sample['text']\n","unit_id":"U000010","unit_sha256":"051fd10693b77477bab5732e2d4bec89df82bc1fc3a64656510181b144a298b1"},{"authority":"AUTHORITATIVE","path":"test_project.py","range":[383,418],"source_id":"test_project","source_sha256":"60a3e343a0f06ad4db35d2570ca6bb5f8f522c831633aadfc7031d7125d344ab","text":"    def test_revoked_access(self):\n","unit_id":"U000014","unit_sha256":"8d84b9a6d9a938e36a20f40bd42d7d827d5962be3a2cc53f779311c68b64dad2"},{"authority":"AUTHORITATIVE","path":"test_project.py","range":[418,485],"source_id":"test_project","source_sha256":"60a3e343a0f06ad4db35d2570ca6bb5f8f522c831633aadfc7031d7125d344ab","text":"        with self.assertRaisesRegex(ValueError, 'ACCESS_REVOKED'):\n","unit_id":"U000015","unit_sha256":"f11b3cd638535e41c8b3e811b097ce7123e2c0fed24a27b00b7e2e829e996427"},{"authority":"AUTHORITATIVE","path":"test_project.py","range":[485,538],"source_id":"test_project","source_sha256":"60a3e343a0f06ad4db35d2570ca6bb5f8f522c831633aadfc7031d7125d344ab","text":"            run('current', 1000, 1100, revoked=True)\n","unit_id":"U000016","unit_sha256":"b1ccdc94fba6952e4cfa2d06402310cb8039ed619c7f95a1b5af3d3525049efa"},{"authority":"AUTHORITATIVE","path":"decision.md","range":[33,104],"source_id":"decision","source_sha256":"fbd33de4e44c248e4130b106c26145416615167251b40cc008481b3f0053256b","text":"Current input is at most 300 seconds old and is never from the future.\n","unit_id":"U000003","unit_sha256":"bd5c09d8e89997bb3e7b634391dde1be34484c505fa7d9278d51379c92a40b8d"},{"authority":"AUTHORITATIVE","path":"decision.md","range":[104,167],"source_id":"decision","source_sha256":"fbd33de4e44c248e4130b106c26145416615167251b40cc008481b3f0053256b","text":"Revoked access blocks processing even when the input is fresh.\n","unit_id":"U000004","unit_sha256":"cd018788ff3493910b8a7957cefcdfea61106bb4b7bfc45d1cbe7283e0e75c94"},{"authority":"AUTHORITATIVE","path":"long_notes.txt","range":[229408,233504],"source_id":"long_notes","source_sha256":"a521cc44a31224476bac5bcbf2825dc6070cda5f78ad69e6f30313f8c560f6b1","text":"","unit_id":"U000002.57","unit_sha256":"a2e659dacb4691e887ac0139f8893d04764ee197d70fb73d3190d56113d18e3e"}],"workspace_id":"offline-fixture"}