{"id": "test_practical_v2_schema.CorrespondenceTests.test_dolt_ignore_configuration_proven_on_live_db", "outcome": "EXPECTED_FAILURE", "reason": "'dolt_ignore' not found in \"create table if not exists mi_practical_v2_grants (store_incarnation varchar(192) not null, grant_id varchar(192) not null, task_id varchar(192) not null, actor varchar(192) not null, status varchar(64) not null, fixed_deadline_utc datetime(6) not null, issue_revision bigint not null, tombstoned tinyint not null default 0, lease_node varchar(192) not null, lease_granted_at datetime not null, lease_expiry datetime not null, lease_heartbeat datetime not null, primary key(store_incarnation, grant_id));\\ncreate table if not exists mi_practical_v2_current_grants (store_incarnation varchar(192) not null, task_id varchar(192) not null, grant_id varchar(192) not null, current_revision bigint not null, primary key(store_incarnation, task_id), unique key mi2_current_grant(store_incarnation, grant_id));\\ncreate table if not exists mi_practical_v2_grant_history (store_incarnation varchar(192) not null, grant_id varchar(192) not null, event_kind varchar(64) not null, event_utc datetime(6) not null, details longtext not null, primary key(store_incarnation, grant_id, event_kind, event_utc));\\ncreate table if not exists mi_practical_v2_metadata (singleton tinyint not null default 1, store_incarnation varchar(192) not null, namespace_key varchar(96) not null default 'identity', selection_digest char(64) null, native_node_id varchar(192) null, selected_database varchar(192) null, selected_main_branch varchar(64) null, primary key(singleton), unique key mi2_metadata_incarnation(store_incarnation));\\ncreate table if not exists mi_practical_v2_token_history (store_incarnation varchar(192) not null, row_token bigint not null, operation_id varchar(192) not null, primary key(store_incarnation, row_token), unique key mi2_token_operation(store_incarnation, operation_id));\\ncreate table if not exists mi_practical_v2_operations (store_incarnation varchar(192) not null, operation_id varchar(192) not null, command_digest char(64) not null, binding_json longtext not null, receipt_json longtext not null, authorization_time datetime(6) not null, resulting_row_lock bigint not null, primary key(store_incarnation, operation_id), unique key mi2_operation_digest(store_incarnation, operation_id, command_digest));\\ncreate procedure if not exists mi_practical_assert_v2(cond bool, err varchar(192)) begin if cond is null or cond <> true then signal sqlstate '45000' set message_text = err; end if; end;\"", "event": "END", "seconds": 0.0, "utc": "2026-11-13T10:13:12.637814+00:00", "monotonic": 6537.5, "pid": 26868}
